{
  "pinned_engine_sha": "bf6dbb13d542243b42a29e4f48e94aface9b67eb",
  "openapi_artifacts": [
    {
      "path": "engine/docs2/openapi.json",
      "sha256": "2f3230eb49d2bc9fd9a73d4551bf9ff8dd20be282f1f8371e8c97b83bfa7679b"
    },
    {
      "path": "engine/demo-dualclient/public/openapi.json",
      "sha256": "2f3230eb49d2bc9fd9a73d4551bf9ff8dd20be282f1f8371e8c97b83bfa7679b"
    }
  ],
  "routes": {
    "submit": {
      "method": "POST",
      "path": "/1/migrations/algolia"
    },
    "status": {
      "method": "GET",
      "path": "/1/migrations/algolia/{job_id}"
    },
    "cancel": {
      "method": "POST",
      "path": "/1/migrations/algolia/{job_id}/cancel"
    }
  },
  "required_runtime_routes": {
    "acknowledge": {
      "method": "POST",
      "path": "/1/migrations/algolia/{job_id}/acknowledge"
    }
  },
  "acknowledgement_contract": {
    "authentication": {
      "required": true,
      "headers": [
        "x-algolia-api-key",
        "x-algolia-application-id"
      ]
    },
    "durability": {
      "terminal_phase_required_before_success": true
    },
    "idempotency": {
      "duplicate_terminal_acknowledgement": "success_no_mutation"
    },
    "absence": {
      "missing_job": {
        "http_status": 404,
        "code": "migration_job_not_found"
      }
    },
    "already_acknowledged": {
      "http_status": 204
    },
    "too_early": {
      "http_status": 409,
      "code": "migration_ack_too_early"
    }
  },
  "request": {
    "required_fields": [
      "apiKey",
      "appId",
      "sourceIndex"
    ],
    "optional_fields": [
      "overwrite",
      "targetIndex"
    ]
  },
  "status": {
    "required_fields": [
      "createdAt",
      "disposition",
      "jobId",
      "phase",
      "updatedAt"
    ],
    "optional_fields": [
      "exportProgress",
      "terminalAt"
    ]
  },
  "progress": {
    "required_fields": [
      "completed",
      "total"
    ],
    "optional_fields": []
  },
  "enums": {
    "phase": [
      "submitted",
      "exporting",
      "preparing",
      "staging",
      "activating"
    ],
    "disposition": [
      "running",
      "succeeded",
      "failed",
      "cancelled"
    ]
  },
  "errors": {
    "migration_ha_unsupported": {
      "http_status": 503
    },
    "migration_capacity_exhausted": {
      "http_status": 503
    },
    "migration_job_not_found": {
      "http_status": 404
    },
    "cancel_too_late": {
      "http_status": 409
    }
  }
}
